<#
.SYNOPSIS
    Deploy-Application.ps1
    PSADT v4 deployment script generated by WinGet-Automater.

    Package : {{PACKAGE_ID}}
    App     : {{APP_NAME}} {{VERSION}}
    Author  : WinGet-Automater (auto-generated)
#>

[CmdletBinding()]
param (
    [Parameter(Mandatory = $false)]
    [ValidateSet('Install', 'Uninstall', 'Repair')]
    [String]$DeploymentType = 'Install',

    [Parameter(Mandatory = $false)]
    [ValidateSet('Interactive', 'Silent', 'NonInteractive')]
    [String]$DeployMode = 'Interactive',

    [Parameter(Mandatory = $false)]
    [Switch]$AllowRebootPassThru,

    [Parameter(Mandatory = $false)]
    [Switch]$TerminalServerMode,

    [Parameter(Mandatory = $false)]
    [Switch]$DisableLogging
)

## ── App Metadata ─────────────────────────────────────────────────────────────
[String]$appVendor      = '{{PUBLISHER}}'
[String]$appName        = '{{APP_NAME}}'
[String]$appVersion     = '{{VERSION}}'
[String]$appArch        = '{{ARCHITECTURE}}'
[String]$appSetupFile   = '{{SETUP_FILE}}'
[String]$appScriptAuthor = 'WinGet-Automater'

## ── Import PSADT Module ───────────────────────────────────────────────────────
Import-Module (Join-Path $PSScriptRoot 'AppDeployToolkit\PSAppDeployToolkit.psd1') -Force

## ── Open Session ─────────────────────────────────────────────────────────────
$adtSession = Open-ADTSession `
    -SessionState    $ExecutionContext.SessionState `
    -DeploymentType  $DeploymentType `
    -DeployMode      $DeployMode `
    -AllowRebootPassThru:$AllowRebootPassThru `
    -TerminalServerMode:$TerminalServerMode `
    -DisableLogging:$DisableLogging `
    -AppVendor   $appVendor `
    -AppName     $appName `
    -AppVersion  $appVersion

## ── Deployment Logic ─────────────────────────────────────────────────────────
try {
    switch ($DeploymentType) {

        'Install' {
            ## Pre-Installation
            Show-ADTInstallationWelcome -CloseApps '{{CLOSE_APPS}}' -AllowDefer -DeferTimes 3 -CheckDiskSpace
            Show-ADTInstallationProgress

            ## Installation
            {{INSTALL_BLOCK}}

            ## Post-Installation (suppress restart prompt in silent mode)
            if ($DeployMode -ne 'Silent') {
                Show-ADTInstallationRestartPrompt -Countdown 25 -CountdownNoHideSeconds 10
            }
        }

        'Uninstall' {
            ## Pre-Uninstallation
            Show-ADTInstallationWelcome -CloseApps '{{CLOSE_APPS}}' -Silent:($DeployMode -eq 'Silent')
            Show-ADTInstallationProgress -StatusMessage "Uninstalling $appName $appVersion..."

            ## Uninstallation
            {{UNINSTALL_BLOCK}}
        }

        'Repair' {
            ## Pre-Repair
            Show-ADTInstallationWelcome -CloseApps '{{CLOSE_APPS}}' -Silent:($DeployMode -eq 'Silent')
            Show-ADTInstallationProgress -StatusMessage "Repairing $appName $appVersion..."

            ## Repair
            {{REPAIR_BLOCK}}
        }
    }
}
finally {
    Close-ADTSession
}
